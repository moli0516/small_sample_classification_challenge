+    __version__="TEST_DOUBLE_NOT_NATIVE_OPTUNA"
+    samplers=types.SimpleNamespace(TPESampler=lambda **kwargs:kwargs)
+    pruners=types.SimpleNamespace(NopPruner=lambda:None)
+    def create_study(self,**kwargs):
